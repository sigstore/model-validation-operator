FROM golang:1.25 AS agent-builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

COPY go.mod go.sum ./
COPY pkg/tracing/go.mod pkg/tracing/go.sum ./pkg/tracing/
RUN go mod download

COPY cmd/validation-agent/ cmd/validation-agent/
COPY internal/ internal/
COPY api/ api/
COPY pkg/ pkg/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -o validation-agent cmd/validation-agent/main.go

FROM gcr.io/distroless/static:nonroot

WORKDIR /

COPY --from=agent-builder /workspace/validation-agent /usr/local/bin/

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/validation-agent"]
